<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Comfy\krea2_t2i.json" LogicalName="ArtStudio.Server.Comfy.krea2_t2i.json" />
    <EmbeddedResource Include="Vision\reconstruct-prompt.txt" LogicalName="ArtStudio.Server.Vision.reconstruct-prompt.txt" />
  </ItemGroup>

  <PropertyGroup>
    <WebProjectDir>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\..\ArtStudio.Web'))\</WebProjectDir>
    <WebInstallStamp>$(WebProjectDir)node_modules\.artstudio-install-stamp</WebInstallStamp>
    <WebBuildOutput>$(MSBuildProjectDirectory)\wwwroot\index.html</WebBuildOutput>
  </PropertyGroup>

  <ItemGroup>
    <WebSources Include="$(WebProjectDir)src\**\*;$(WebProjectDir)public\**\*" />
    <WebSources Include="$(WebProjectDir)index.html;$(WebProjectDir)vite.config.ts;$(WebProjectDir)tsconfig*.json;$(WebProjectDir)package*.json" />
  </ItemGroup>

  <Target Name="InstallWebDependencies" Inputs="$(WebProjectDir)package-lock.json" Outputs="$(WebInstallStamp)">
    <Exec Command="npm install" WorkingDirectory="$(WebProjectDir)" />
    <Touch Files="$(WebInstallStamp)" AlwaysCreate="true" />
  </Target>

  <Target Name="BuildWeb" BeforeTargets="BeforeBuild" DependsOnTargets="InstallWebDependencies"
          Inputs="@(WebSources);$(WebInstallStamp)" Outputs="$(WebBuildOutput)">
    <Exec Command="npm run build" WorkingDirectory="$(WebProjectDir)" />
    <!-- Content was globbed at evaluation time, before Vite replaced the hashed bundle files. A wildcard Remove
         inside a target only matches files that still exist, so stale entries are dropped by an Exists check. -->
    <ItemGroup>
      <Content Remove="@(Content)" Condition="!Exists('%(FullPath)')" />
      <Content Include="wwwroot\**" Exclude="@(Content)" />
    </ItemGroup>
  </Target>

</Project>
